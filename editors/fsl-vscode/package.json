{
  "name": "fsl-language",
  "displayName": "FSL — Fluxxi Shader Language",
  "description": "Syntax highlighting for the Fluxxi Shader Language (.fsl), a compute-shader language that transpiles to GLSL.",
  "version": "0.1.0",
  "publisher": "fluxx7",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fluxx7/FluxxiShaderLanguage-Godot.git",
    "directory": "editors/fsl-vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "fsl",
    "shader",
    "glsl",
    "compute",
    "godot"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fsl",
        "aliases": [
          "FSL",
          "Fluxxi Shader Language"
        ],
        "extensions": [
          ".fsl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fsl",
        "scopeName": "source.fsl",
        "path": "./syntaxes/fsl.tmLanguage.json"
      }
    ]
  }
}
