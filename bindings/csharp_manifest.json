{
  "namespace": "FluxxiShaderLang",
  "engine_enums": ["RenderingDevice.UniformType"],
  "classes": {
    "FSLResource": {
      "base": "RefCounted",
      "abstract": true,
      "methods": [
        { "name": "get_rid", "return": "Rid" },
        { "name": "connect_and_call", "args": [{ "name": "event_handler", "type": "Callable" }] }
      ],
      "signals": [
        { "name": "rid_changed" }
      ]
    },
    "FSLBuffer": {
      "extends": "FSLResource",
      "abstract": true
    },
    "FSLTexture": {
      "extends": "FSLResource",
      "abstract": true
    },
    "FSLRawResource": {
      "extends": "FSLResource",
      "methods": [
        { "name": "from_rid", "static": true, "return": "FSLRawResource", "args": [
          { "name": "rid", "type": "Rid" },
          { "name": "uniform_type", "type": "RenderingDevice.UniformType" }
        ] },
        { "name": "set_rid", "args": [{ "name": "rid", "type": "Rid" }] },
        { "name": "set_uniform_type", "args": [{ "name": "uniform_type", "type": "RenderingDevice.UniformType" }] },
        { "name": "get_uniform_type", "return": "RenderingDevice.UniformType" }
      ]
    },
    "FSLStorageBuffer": {
      "extends": "FSLBuffer",
      "methods": [
        { "name": "set_field", "args": [{ "name": "field", "type": "StringName" }, { "name": "value", "type": "Variant" }] },
        { "name": "set_buffer", "args": [{ "name": "values", "type": "Godot.Collections.Dictionary<StringName, Variant>" }] },
        { "name": "set_unsized_element_count", "args": [{ "name": "num_elements", "type": "uint" }] }
      ]
    },
    "FSLUniformBuffer": {
      "extends": "FSLBuffer",
      "methods": [
        { "name": "set_field", "args": [{ "name": "field", "type": "StringName" }, { "name": "value", "type": "Variant" }] },
        { "name": "set_buffer", "args": [{ "name": "values", "type": "Godot.Collections.Dictionary<StringName, Variant>" }] }
      ]
    },
    "FSLVertexBuffer": {
      "extends": "FSLBuffer"
    },
    "FSLIndexBuffer": {
      "extends": "FSLBuffer",
      "methods": [
        { "name": "set_field", "args": [{ "name": "field", "type": "StringName" }, { "name": "value", "type": "Variant" }] },
        { "name": "set_buffer", "args": [{ "name": "values", "type": "Godot.Collections.Dictionary<StringName, Variant>" }] }
      ]
    },
    "FSLTexture2D": {
      "extends": "FSLTexture",
      "methods": [
        { "name": "set_texture", "args": [
          { "name": "tex_width", "type": "uint" },
          { "name": "tex_height", "type": "uint" },
          { "name": "image", "type": "Image", "default": "null" }
        ] }
      ]
    },
    "FSLTexture2DArray": {
      "extends": "FSLTexture",
      "methods": [
        { "name": "set_texture", "args": [
          { "name": "tex_width", "type": "uint" },
          { "name": "tex_height", "type": "uint" },
          { "name": "index", "type": "uint" },
          { "name": "image", "type": "Image", "default": "null" }
        ] },
        { "name": "set_textures", "args": [
          { "name": "tex_width", "type": "uint" },
          { "name": "tex_height", "type": "uint" },
          { "name": "tex_count", "type": "uint" },
          { "name": "images", "type": "Godot.Collections.Array<Image>", "default": "null" }
        ] }
      ]
    },
    "ComputeKernel": {
      "base": "RefCounted",
      "enums": {
        "BufferType": { "Storage": 0, "Uniform": 1 },
        "TextureFormat": { "Rgba32F": 0, "Rgba16F": 1 }
      },
      "methods": [
        { "name": "print_info" },
        { "name": "dispatch", "args": [
          { "name": "x_invocations", "type": "uint" },
          { "name": "y_invocations", "type": "uint" },
          { "name": "z_invocations", "type": "uint" },
          { "name": "push_constants", "type": "Godot.Collections.Dictionary<StringName, Variant>", "default": "null" }
        ] },
        { "name": "dispatch_workgroups", "args": [
          { "name": "x_workgroups", "type": "uint" },
          { "name": "y_workgroups", "type": "uint" },
          { "name": "z_workgroups", "type": "uint" },
          { "name": "push_constants", "type": "Godot.Collections.Dictionary<StringName, Variant>", "default": "null" }
        ] },
        { "name": "assign_resource", "args": [
          { "name": "resource", "type": "FSLResource" },
          { "name": "resource_name", "type": "StringName" }
        ] },
        { "name": "get_storage_buffer", "return": "FSLStorageBuffer", "args": [{ "name": "buffer_name", "type": "StringName" }] },
        { "name": "get_uniform_buffer", "return": "FSLUniformBuffer", "args": [{ "name": "buffer_name", "type": "StringName" }] },
        { "name": "get_vertex_buffer", "return": "FSLVertexBuffer", "args": [{ "name": "buffer_name", "type": "StringName" }] },
        { "name": "get_index_buffer", "return": "FSLIndexBuffer", "args": [{ "name": "buffer_name", "type": "StringName" }] },
        { "name": "get_texture_2d", "return": "FSLTexture2D", "args": [{ "name": "texture_name", "type": "StringName" }] },
        { "name": "get_texture_2d_array", "return": "FSLTexture2DArray", "args": [{ "name": "texture_name", "type": "StringName" }] },
        { "name": "get_resource", "return": "FSLResource", "args": [{ "name": "resource_name", "type": "StringName" }] }
      ]
    },
    "ComputeGroup": {
      "base": "RefCounted",
      "methods": [
        { "name": "print_info" },
        { "name": "get_kernel", "return": "ComputeKernel", "args": [{ "name": "kernel_name", "type": "StringName" }] },
        { "name": "assign_resource", "args": [
          { "name": "resource", "type": "FSLResource" },
          { "name": "resource_name", "type": "StringName" }
        ] },
        { "name": "dispatch", "args": [
          { "name": "kernel_name", "type": "StringName" },
          { "name": "x_invocations", "type": "uint" },
          { "name": "y_invocations", "type": "uint" },
          { "name": "z_invocations", "type": "uint" },
          { "name": "push_constants", "type": "Godot.Collections.Dictionary<StringName, Variant>", "default": "null" }
        ] },
        { "name": "get_storage_buffer", "return": "FSLStorageBuffer", "args": [{ "name": "buffer_name", "type": "StringName" }] },
        { "name": "get_uniform_buffer", "return": "FSLUniformBuffer", "args": [{ "name": "buffer_name", "type": "StringName" }] },
        { "name": "get_vertex_buffer", "return": "FSLVertexBuffer", "args": [{ "name": "buffer_name", "type": "StringName" }] },
        { "name": "get_index_buffer", "return": "FSLIndexBuffer", "args": [{ "name": "buffer_name", "type": "StringName" }] },
        { "name": "get_texture_2d", "return": "FSLTexture2D", "args": [{ "name": "texture_name", "type": "StringName" }] },
        { "name": "get_texture_2d_array", "return": "FSLTexture2DArray", "args": [{ "name": "texture_name", "type": "StringName" }] },
        { "name": "get_resource", "return": "FSLResource", "args": [{ "name": "resource_name", "type": "StringName" }] }
      ]
    },
    "ComputePlan": {
      "base": "RefCounted",
      "methods": [
        { "name": "make_new", "static": true, "return": "ComputePlan", "args": [
          { "name": "rendering_device", "type": "RenderingDevice" }
        ] },
        { "name": "add_barrier", "return": "ComputePlan", "args": [
          { "name": "is_temp", "type": "bool", "default": "false" }
        ] },
        { "name": "add_kernel", "return": "ComputePlan", "args": [
          { "name": "kernel", "type": "ComputeKernel" },
          { "name": "x_invocations", "type": "uint" },
          { "name": "y_invocations", "type": "uint" },
          { "name": "z_invocations", "type": "uint" },
          { "name": "push_constants", "type": "Godot.Collections.Dictionary<StringName, Variant>", "default": "null" },
          { "name": "is_temp", "type": "bool", "default": "false" }
        ] },
        { "name": "add_plan", "args": [
          { "name": "subplan", "type": "ComputePlan" },
          { "name": "is_temp", "type": "bool", "default": "false" }
        ] },
        { "name": "dispatch" }
      ]
    },
    "FSLFile": {
      "base": "RefCounted",
      "methods": [
        { "name": "test" },
        { "name": "from_file", "static": true, "return": "FSLFile", "args": [
          { "name": "file_path", "type": "string" }
        ] },
        { "name": "get_kernel_source", "return": "string", "args": [
          { "name": "kernel_name", "type": "StringName" }
        ] },
        { "name": "get_kernel", "return": "ComputeKernel", "args": [
          { "name": "kernel_name", "type": "StringName" },
          { "name": "rendering_device", "type": "RenderingDevice", "default": "null" }
        ] },
        { "name": "get_kernel_group", "return": "ComputeGroup", "args": [
          { "name": "rendering_device", "type": "RenderingDevice", "default": "null" }
        ] }
      ]
    }
  }
}
