// Shared helper include for the test suite.
// Include guard built from #ifdef/#else, since #ifndef is not in the language (yet).
// This file is included twice (directly and via level2.fsl) to stress diamond includes.
#ifdef MATH_COMMON_INCLUDED
#else
#define MATH_COMMON_INCLUDED

const f32 PI = 3.14159265358979;

#define HALF(x) ((x) * 0.5)

f32 sqr(f32 x) {
    return x * x;
}

f32x2 cmul(f32x2 a, f32x2 b) {
    return f32x2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

#endif
