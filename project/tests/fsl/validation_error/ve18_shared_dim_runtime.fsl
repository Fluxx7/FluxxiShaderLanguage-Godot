//! EXPECT: validation_error
// Shared array dims may be comptime or pipeline constant, but never runtime:
// sizing one from a buffer field must be rejected.

buffer["paramsBlock"] params {
    u32 runtime_size;
};

buffer["sinkBuf"] {
    f32[] sink;
};

shared f32[params.runtime_size] cache;

kernel[8, 1, 1] sharedDimRuntime(l : LocalInvocationID) {
    cache[l.x] = f32(l.x);
    sink[l.x] = cache[l.x];
}
