//! EXPECT: validation_error
// Call site matches no overload: wrong argument count and wrong types.

layout(std430) buffer sinkBuf {
    f32[] sink;
};

f32 combine(f32 a, f32 b) {
    return a + b;
}

f32x2 combine(f32x2 a, f32x2 b) {
    return a + b;
}

kernel[1, 1, 1] noMatchingOverload() {
    sink[0] = combine(1.0);
    sink[1] = combine(f32x3(1.0, 2.0, 3.0), 2.0).x;
}
