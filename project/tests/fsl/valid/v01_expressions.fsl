//! EXPECT: valid
//! KERNELS: exprTorture
//
// Expression stress test: operator precedence, unary chains, ternaries,
// swizzle chains and write masks, literal formats, nested calls/indexing,
// every compound assignment operator.

layout(std430) buffer exprResults {
    f32[] results;
};

const f32 BIG = 1.0e12;
const f32 TINY = 1e-6;

kernel[64, 1, 1] exprTorture(id : GlobalInvocationID, u32 count, f32 scale) {
    if (id.x >= count) return;
    u32 i = id.x;

    // precedence mix: shifts, bitwise, arithmetic, comparison, logical
    u32 bits = ((i << 3) | (i >> 1)) & ~(i * 3u) ^ 0xF0u;
    bool weird = (i % 5u != 0u) && !(i == 3u) || (bits > 128u);

    // nested ternaries
    f32 t = weird ? (i > 32u ? 1.0 : 0.25) : (bits == 0u ? -1.0 : TINY);

    // unary chains
    f32 n = -(-(-t));
    bool  b = !!weird;

    // literal formats: trailing dot, leading dot, exponents, suffixes, hex
    f32 lits = 1. + .5 + 1.5e+3 + 2E-2 + 0.5f + f32(0x1Fu) + f32(3u);

    // swizzle chains and write masks
    f32x4 v = f32x4(t, n, scale, 1.0);
    f32x2 sw = v.wzyx.yx;
    v.xy += sw.yx * 2.0;
    v.zw = v.xx;
    f32 single = v.xyzw.wzyx.x;

    // deeply nested parens
    f32 deep = ((((((((t + 1.0)))))))) * (((n)));

    // every compound assignment
    f32 acc = 0.0;
    acc += t; acc -= n; acc *= 2.0; acc /= 4.0;
    u32 u = i;
    u %= 7u; u <<= 2; u >>= 1; u &= 0xFFu; u |= 1u; u ^= 0x10u;
    u++; ++u; u--; --u;

    // nested calls feeding nested indexing
    results[(i + u32(floor(abs(sin(f32(i) * TINY)) * 8.0))) % count] = acc;
    results[i] = acc * t + f32(u) + single + deep + lits + v.x + (b ? BIG : 0.0);
}
