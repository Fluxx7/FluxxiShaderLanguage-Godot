//! EXPECT: valid
//! KERNELS: allBuiltins pushHeavy minimal sharedUser1 sharedUser2
//
// Kernel declaration stress test: all six builtin bindings, push constants
// interleaved with builtins, a zero-argument kernel, macro-driven local
// sizes, and two kernels sharing one shared array.

#define GROUP 8

layout(std430) buffer kBuf {
    f32[] k_out;
};

shared f32[GROUP * GROUP] wg_scratch;

kernel[GROUP, GROUP, 1] allBuiltins(
        g : GlobalInvocationID,
        l : LocalInvocationID,
        li : LocalInvocationIndex,
        wg : WorkGroupID,
        wgs : WorkGroupSize,
        nwg : NumWorkGroups) {
    k_out[g.x] = f32(l.x + li + wg.y + wgs.z + nwg.x);
}

kernel[64, 1, 1] pushHeavy(u32 count, g : GlobalInvocationID, f32 a, f32 b,
                           i32 mode, l : LocalInvocationID, u32x2 span, f32x4 tint) {
    if (g.x >= count) return;
    k_out[g.x] = a * b + f32(mode) + f32(span.x + span.y) + tint.w + f32(l.x);
}

kernel[1, 1, 1] minimal() {
    k_out[0] = 1.0;
}

kernel[GROUP, GROUP, 1] sharedUser1(li : LocalInvocationIndex) {
    wg_scratch[li] = f32(li);
}

kernel[GROUP, GROUP, 1] sharedUser2(li : LocalInvocationIndex) {
    wg_scratch[li] = f32(li) * 2.0;
    barrier();
    k_out[li] = wg_scratch[(li + 1u) % u32(GROUP * GROUP)];
}
