//! EXPECT: valid
//! KERNELS: allBuiltins pushHeavy minimal sharedUser1 sharedUser2
//
// Kernel declaration stress test: all six builtin bindings, push constants
// interleaved with builtins, a zero-argument kernel, macro-driven local
// sizes, and two kernels sharing one shared array.

#define GROUP 8

layout(std430) buffer kBuf {
    float[] k_out;
};

shared float[GROUP * GROUP] wg_scratch;

kernel[GROUP, GROUP, 1] allBuiltins(
        g : GlobalInvocationID,
        l : LocalInvocationID,
        li : LocalInvocationIndex,
        wg : WorkGroupID,
        wgs : WorkGroupSize,
        nwg : NumWorkGroups) {
    k_out[g.x] = float(l.x + li + wg.y + wgs.z + nwg.x);
}

kernel[64, 1, 1] pushHeavy(uint count, g : GlobalInvocationID, float a, float b,
                           int mode, l : LocalInvocationID, uint2 span, float4 tint) {
    if (g.x >= count) return;
    k_out[g.x] = a * b + float(mode) + float(span.x + span.y) + tint.w + float(l.x);
}

kernel[1, 1, 1] minimal() {
    k_out[0] = 1.0;
}

kernel[GROUP, GROUP, 1] sharedUser1(li : LocalInvocationIndex) {
    wg_scratch[li] = float(li);
}

kernel[GROUP, GROUP, 1] sharedUser2(li : LocalInvocationIndex) {
    wg_scratch[li] = float(li) * 2.0;
    barrier();
    k_out[li] = wg_scratch[(li + 1u) % uint(GROUP * GROUP)];
}
