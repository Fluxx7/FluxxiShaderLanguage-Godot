//! EXPECT: valid
//! KERNELS: funcKernel
//
// Function stress test: four-way overloading, out/inout/const-in specifiers,
// no-arg functions, and a call chain three levels deep that bottoms out in a
// buffer write (exercises transitive resource propagation through the call
// graph: funcKernel must bind fnBuf even though it never touches it directly).

layout(std430) buffer fnBuf {
    float[] fn_out;
};

float blend(float a, float b) { return a + b; }
float2 blend(float2 a, float2 b) { return a + b; }
float2 blend(float a, float2 b) { return float2(a, a) + b; }
float blend(float a, float b, float t) { return a * (1.0 - t) + b * t; }

void split(float v, out float lo, out float hi) {
    lo = fract(v);
    hi = v - lo;
}

void accumulate(inout float acc, const in float amount) {
    acc += amount;
}

float depth3(uint i, float v) {
    fn_out[i] = v;
    return v * 2.0;
}
float depth2(uint i, float v) { return depth3(i, v + 1.0); }
float depth1(uint i, float v) { return depth2(i, blend(v, 2.0, 0.5)); }

float noArgs() { return 42.0; }

kernel[32, 1, 1] funcKernel(id : GlobalInvocationID, float t) {
    float lo = 0.0;
    float hi = 0.0;
    split(t * float(id.x), lo, hi);
    float acc = noArgs();
    accumulate(acc, lo);
    float2 v2 = blend(hi, float2(lo, acc));
    acc = blend(v2.x, v2.y) + blend(lo, hi, 0.25);
    depth1(id.x, acc);
}
