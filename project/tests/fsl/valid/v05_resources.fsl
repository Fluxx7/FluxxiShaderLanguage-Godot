//! EXPECT: valid
//! KERNELS: resKernelA resKernelB
//
// Resource declaration stress test: all four buffer layouts (std140, std430,
// vertex, index), named and anonymous blocks, both image types and formats,
// a bare uniform variable, and kernels touching disjoint resource subsets
// (exercises the used-resource filtering: resKernelA must only bind dataBlock
// and globalScale).

layout(std140) buffer paramBlock {
    f32x4 tint;
    u32 count;
} params;

layout(std430) buffer dataBlock {
    f32[] data;
};

layout(std430) buffer meshVerts : godot_vertex {
    f32x3 position;
    f32x2 uv;
};

layout(std430) buffer meshIndices : godot_index {
    u32 index;
};

layout(rgba32f) uniform image2D outImage;
layout(rgba16f) uniform image2DArray layerImage;

uniform f32 globalScale;

kernel[64, 1, 1] resKernelA(id : GlobalInvocationID) {
    data[id.x] = f32(id.x) * globalScale;
}

kernel[8, 8, 1] resKernelB(id : GlobalInvocationID) {
    if (id.x >= params.count) return;
    f32x4 px = imageLoad(layerImage, i32x3(i32(id.x), i32(id.y), 0)) * params.tint;
    imageStore(outImage, i32x2(id.xy), px);
}
