//! EXPECT: valid
//! KERNELS: resKernelA resKernelB
//
// Resource declaration stress test for the reworked resource system:
// buffers keyed by a string name, storage vs. uniform blocks, named
// (instance-qualified) and anonymous blocks, buffer annotations
// (godot_vertex, godot_index, flag_indirect), format-parameterized image
// types, a sampler, and kernels touching disjoint resource subsets
// (exercises the used-resource filtering: resKernelA must only bind
// dataBlock and dispatchBlock).

uniform buffer["paramBlock"] params {
    f32x4 tint;
    u32 count;
};

buffer["dataBlock"] {
    f32[] data;
};

buffer["meshVerts"] : godot_vertex {
    f32x3 position;
    f32x2 uv;
};

buffer["meshIndices"] index_buffer : godot_index {
    u32[] index;
};

buffer["dispatchBlock"] dispatch_args : flag_indirect {
    u32 group_count_x;
    u32 group_count_y;
    u32 group_count_z;
};

uniform image2D<f32x4> outImage;
uniform image2DArray<f16x4> layerImage;
uniform sampler layerSampler;

kernel[64, 1, 1] resKernelA(id : GlobalInvocationID) {
    data[id.x] = f32(id.x);
    if (id.x == 0u) {
        dispatch_args.group_count_x = 1;
    }
}

kernel[8, 8, 1] resKernelB(id : GlobalInvocationID) {
    if (id.x >= params.count) return;
    f32x4 px = imageLoad(layerImage, i32x3(i32(id.x), i32(id.y), 0)) * params.tint;
    px += layerSampler(layerImage)[f32x3(f32x2(id.xy) / 64.0, 0.0)];
    imageStore(outImage, i32x2(id.xy), px);
}
