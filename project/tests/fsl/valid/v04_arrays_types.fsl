//! EXPECT: valid
//! KERNELS: arrayTorture
//
// Type-prefix array stress test (design decision: f32x2[4] x, not
// f32x2 x[4]): macro-sized dims, comptime-expression dims, multi-dim
// arrays, unsized trailing buffer member, shared arrays, array params,
// const global array with constructor initializer, chained indexing.

#define N 16

layout(std430) buffer arrayBuf {
    f32x4[N] header;
    f32x2[N / 2][2] pairs;
    f32[] tail;
};

shared f32[N][N] tile_cache;
shared u32[N * N / 4] packed_cache;

const f32x2[4] offsets = f32x2[4](
    f32x2(-1.0, 0.0), f32x2(1.0, 0.0),
    f32x2(0.0, -1.0), f32x2(0.0, 1.0)
);

f32 sum4(const f32[4] xs) {
    f32 s = 0.0;
    for (i32 i = 0; i < 4; i++) s += xs[i];
    return s;
}

kernel[N, N, 1] arrayTorture(g : GlobalInvocationID, l : LocalInvocationID) {
    // local fixed-size array, filled then passed as an argument
    f32[4] local_arr;
    for (i32 i = 0; i < 4; i++) local_arr[i] = f32(i) + offsets[i].x;

    tile_cache[l.y][l.x] = sum4(local_arr);
    packed_cache[(l.y * u32(N) + l.x) / 4u] = l.x;
    barrier();

    // nested / chained indexing and swizzles on indexed elements
    f32 v = tile_cache[u32(local_arr[2])][l.x] + pairs[l.x % u32(N / 2)][1].y;
    header[l.x % u32(N)].xy += offsets[i32(v) & 3];
    tail[g.x + g.y * u32(N)] = v;
}
