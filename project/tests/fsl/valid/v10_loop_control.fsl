//! EXPECT: valid
//! KERNELS: loopControl
//
// Loop-control target test: break, continue, and while are not currently
// lexed as keywords, but a compute language needs them — these are targets
// for the stack to grow into. (Delete the while section if while is
// deliberately out of scope.)

layout(std430) buffer loopBuf {
    u32[] loop_out;
};

kernel[32, 1, 1] loopControl(id : GlobalInvocationID) {
    u32 acc = 0u;
    for (u32 i = 0u; i < 64u; i++) {
        if (i % 2u == 0u) continue;
        if (i > 32u) break;
        acc += i;
    }

    // infinite for with break as the only exit
    u32 guard = 0u;
    for (;;) {
        guard++;
        if (guard > 8u) break;
    }

    u32 n = acc + id.x + 1u;
    while (n > 1u) {
        n = (n % 2u == 0u) ? n / 2u : 3u * n + 1u;
        acc++;
    }

    loop_out[id.x] = acc + guard;
}
