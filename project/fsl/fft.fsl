#include "shared_resources.fsl"
//#define USE_NORMALIZATION

layout(std430) buffer twiddleFactors {
    f32x2[] twiddles;
};


// buffer shape:
// [numCascades][2][N * N]
layout(std430) buffer fft_buffers {
    f32x2[] fft_data;
};

#define fft_index(x, y) fft_data[(cascade_index * N + y ) * N + x ] 
#define fft_vindex(v) fft_index(v.x, v.y)

const u32 FFT_SIZE_HALF = 128;
const u32 FFT_SIZE = FFT_SIZE_HALF * 2;


kernel[32, 1, 1] twiddleGen(id : GlobalInvocationID, u32 N) {
	if (id.x >= (N / 2)) return;
	u32 x = id.x;
	f32 theta = 2.0 * PI * f32(x) / f32(N);
	twiddles[x] = f32x2(cos(theta), sin(theta));
}

shared f32x2[FFT_SIZE_HALF] local_twiddles;
shared f32x2[2][FFT_SIZE] local_data;

#define dest(ind) local_data[curr_dest][ind]
#define source(ind) local_data[curr_source][ind]

void ifft_stage(u32 N, u32 stage, u32 curr_source, u32 curr_dest, const u32x3 coords) {
	u32 x_coord = coords.x;
	u32 y_coord = coords.y;
	u32 cascade_index = coords.z;
	u32 index_base = N >> (stage + 1);
	u32 group_size = 1 << stage;
	u32 group = x_coord & ~(group_size - 1);
	u32 group_index = x_coord & (group_size - 1);
	
	// compute the indices to read from
	u32 source_index_1 = x_coord;
	u32 source_index_2 = source_index_1 + N/2;

	// compute the indices to write to
	u32 dest_index_1 = x_coord + group; 
	u32 dest_index_2 = dest_index_1 + group_size;

	// calculate the twiddle factor index to read from and retrieve that value 
	u32 twiddle_index = (source_index_1 & (group_size - 1)) * index_base;
	f32x2 twiddle = local_twiddles[twiddle_index];


	// load and twiddle the "odd" value, and load the "even" value
	f32x2 twiddled_x = complex_mult(twiddle, source(source_index_2));
	f32x2 even_x = source(source_index_1);

	// calculate the output values and write them to the determined indices
#ifdef USE_NORMALIZATION
	dest(dest_index_2) = complex_mult(even_x - twiddled_x, 0.5);
	dest(dest_index_1) = complex_mult(even_x + twiddled_x, 0.5);
#else
	dest(dest_index_2) = even_x - twiddled_x;
	dest(dest_index_1) = even_x + twiddled_x;
#endif
}

kernel[FFT_SIZE_HALF, 1, 1] ifftRow(g_id : GlobalInvocationID, l_id : LocalInvocationID, wgs : WorkGroupSize) {
	u32 x_coord = g_id.x;
	u32 y_coord = g_id.y;
	u32 N = 2u * wgs.x;
	if (x_coord >= N/2 || y_coord >= N || g_id.z >= MAX_CASCADES) {
		return;
	}
	const i32 cascade_index = i32(g_id.z);
	
	u32 logN = u32(findMSB(N));
	u32 curr_source = 0;
	u32 curr_dest = 1;
	local_twiddles[x_coord] = twiddles[x_coord];
	local_data[0][x_coord] = fft_index(l_id.x, g_id.y);
	local_data[0][x_coord + wgs.x] = fft_index(l_id.x + wgs.x, g_id.y);
	barrier();
	
	for (u32 stage = 0u; stage < logN; stage++) {
		ifft_stage(N, stage, curr_source, curr_dest, u32x3(x_coord, y_coord, cascade_index));
		barrier();
		
		u32 next_dest = curr_source;
		curr_source = curr_dest;
		curr_dest = next_dest;
	}

	fft_index(l_id.x, g_id.y) = local_data[curr_source][x_coord];
	fft_index(l_id.x + wgs.x, g_id.y) = local_data[curr_source][x_coord + wgs.x];
}

kernel[FFT_SIZE_HALF, 1, 1] ifftColumn(g_id : GlobalInvocationID, l_id : LocalInvocationID, wgs : WorkGroupSize) {
	u32 x_coord = g_id.x;
	u32 y_coord = g_id.y;
	u32 N = 2u * wgs.x;
	if (x_coord >= N/2 || y_coord >= N || g_id.z >= MAX_CASCADES) {
		return;
	}
	const i32 cascade_index = i32(g_id.z);
	
	u32 logN = u32(findMSB(N));
	u32 curr_source = 0;
	u32 curr_dest = 1;
	local_twiddles[x_coord] = twiddles[x_coord];
	local_data[0][x_coord] = fft_index(g_id.y, l_id.x);
	local_data[0][x_coord + wgs.x] = fft_index(g_id.y, l_id.x + wgs.x);
	barrier();
	for (u32 stage = 0u; stage < logN; stage++) {
		ifft_stage(N, stage, curr_source, curr_dest, u32x3(x_coord, y_coord, cascade_index));
		barrier();
		u32 next_dest = curr_source;
		curr_source = curr_dest;
		curr_dest = next_dest;
	}
	fft_index(g_id.y, l_id.x) = local_data[curr_source][x_coord];
	fft_index(g_id.y, l_id.x + wgs.x) = local_data[curr_source][x_coord + wgs.x];
}