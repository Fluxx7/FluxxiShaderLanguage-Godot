#include "shared_resources.fsl"

layout(rgba32f) uniform image2DArray spectrumCoefficients;

kernel[32, 32, 1] noSpreading(g_id : GlobalInvocationID, i32 texSize, f32 strength) {
    if (g_id.x >= texSize) return;
    if (g_id.y >= texSize) return;
    if (g_id.z >= paramsBuffer.numCascades) return;
    i32x2 id = i32x2(g_id.xy);
    const i32 cascade_index = i32(g_id.z);
    const f32 tile_length = paramsBuffer.cascadeParams[cascade_index].x;

    f32 base_sample = imageLoad(spectrumMap, i32x3(id, cascade_index)).r;
    f32x2 coeffs = imageLoad(spectrumCoefficients, i32x3(id, cascade_index)).rg;
    f32x2 k_vec = 2.0 * PI * (id - texSize * 0.5) / tile_length;
    f32 direction_spectrum = base_sample / (2.0 * PI);
    f32 output_coeff = sqrt(direction_spectrum) * (2.0 * PI / tile_length) / sqrt(2.0);
    f32x2 out_values = output_coeff * coeffs;
    imageStore(baseSpectrum, i32x3(id, cascade_index), f32x4(out_values, 0.0, 1.0));
}


f32 positive_cos_spreading(f32x2 k_vec, f32 windDirection) {
    f32 wave_direction = atan(k_vec.y, k_vec.x);
    f32 theta = wave_direction - windDirection;
    if (abs(theta) > (PI / 2.0)) {
        return 0.0;
    }
    return 2.0 * pow(cos(theta), 2.0) / PI;
}

kernel[32, 32, 1] positiveCosSpreading(g_id : GlobalInvocationID, i32 texSize, f32 strength) {
    if (g_id.x >= texSize) return;
    if (g_id.y >= texSize) return;
    if (g_id.z >= paramsBuffer.numCascades) return;
    i32x2 id = i32x2(g_id.xy);
    const i32 cascade_index = i32(g_id.z);
	const f32 tile_length = paramsBuffer.cascadeParams[cascade_index].x;

    f32 base_sample = imageLoad(spectrumMap, i32x3(id, cascade_index)).r;
    f32x2 coeffs = imageLoad(spectrumCoefficients, i32x3(id, cascade_index)).rg;
    f32x2 k_vec = 2.0 * PI * (id - texSize * 0.5) / tile_length;
    f32 no_spread_spectrum = base_sample / (2.0 * PI);
    f32 direction_spectrum = base_sample * positive_cos_spreading(k_vec, paramsBuffer.windDirection);
    f32 output_coeff = sqrt(mix(no_spread_spectrum, direction_spectrum, strength)) * (2.0 * PI / tile_length) / sqrt(2.0);
    
    imageStore(baseSpectrum, i32x3(id, cascade_index), f32x4(output_coeff * coeffs.x, output_coeff * coeffs.y, 0.0, 1.0));
}

