#define MAX_CASCADES 4

const f32 PI = 3.1415926535897932384626433;
const f32 g = 9.81;
const f32 water_surface_tension = 0.074;
const f32 water_density = 1000.0;

f32x2 complex_mult(f32x2 a, f32x2 b) {
    return f32x2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

f32x2 complex_mult(f32 a, f32x2 b) {
    return f32x2(a * b.x, a * b.y );
}

f32x2 complex_mult(f32x2 a, f32 b) {
    return f32x2(a.x * b, a.y * b );
}

f32x2 complex_conj(f32x2 num) {
    num.y *= -1.0;
    return num;
}

f32x2 exp_j(f32 theta) {
    return f32x2(cos(theta), sin(theta));
}

layout(rgba32f) uniform image2DArray spectrumMap;
layout(rgba32f) uniform image2DArray baseSpectrum;
layout(rgba32f) uniform image2DArray spectrumTexture;

layout(std430) buffer oceanParams {
	u32 numCascades;
	f32 windSpeed;
	f32 windDirection;
	f32 depth;
	f32 fetch;
	f32x4[] cascadeParams; // [tile length, whitecap, foam amount, unused]
} paramsBuffer;

layout(std430) buffer spectrumDataBuffer {
	f32 omega_peak;
} spectrumData;

f32 dispersion_relation(f32 k_mag, f32 depth, out f32 tan_k) {
    tan_k = tanh(k_mag * depth);
    return sqrt(g * k_mag * tan_k + pow(k_mag, 3.0) * water_surface_tension / water_density);
}